# =============================================================================
# StudySphere environment variables
# Copy to `.env` for local development. Set the same keys in Vercel → Settings
# → Environment Variables for Preview/Production.
# =============================================================================

# --- Database (PostgreSQL / Neon) ---------------------------------------------
# Use the Neon **pooled** connection string for the app (serverless-friendly).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Use the Neon **direct** (non-pooler) connection string for Prisma migrations.
# For a single local Postgres instance, DIRECT_URL can match DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Local backup: the previous SQLite file `prisma/dev.db` is kept on disk as a
# reference only. Prisma no longer uses SQLite. Do not point DATABASE_URL at
# `file:./dev.db`.

# --- Auth.js / NextAuth v5 ----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-32-byte-secret"
# Local:
AUTH_URL="http://localhost:3000"
# Production (example): AUTH_URL="https://your-app.vercel.app"

# --- File storage -------------------------------------------------------------
# Local development (default when Blob is not configured):
UPLOAD_DIR="./uploads"

# Production / Vercel Blob (private store):
# Create a **Private** Blob store in the Vercel dashboard and connect it to the
# project. Vercel injects BLOB_READ_WRITE_TOKEN (and/or BLOB_STORE_ID via OIDC).
# When either Blob env is present, uploads go to private Blob; otherwise the
# app falls back to UPLOAD_DIR on the local filesystem.
# BLOB_READ_WRITE_TOKEN=""
# BLOB_STORE_ID=""

# --- Optional search ----------------------------------------------------------
BRAVE_SEARCH_API_KEY=""

# --- Email (Resend) -----------------------------------------------------------
# Required in production so verification and password-reset links are actually
# delivered. Create an API key at https://resend.com and verify the sending
# domain used by EMAIL_FROM.
# When these are unset (local dev), no mail is sent and the register /
# forgot-password responses include the link instead.
RESEND_API_KEY=""
EMAIL_FROM="StudySphere <no-reply@your-domain.com>"
