# =============================================================================
# StudySphere environment variables
# Copy to `.env` for local development. Set the same keys in Vercel → Settings
# → Environment Variables for Preview/Production.
# =============================================================================

# --- Database (PostgreSQL / Neon) ---------------------------------------------
# Use the Neon **pooled** connection string for the app (serverless-friendly).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Use the Neon **direct** (non-pooler) connection string for Prisma migrations.
# For a single local Postgres instance, DIRECT_URL can match DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Local backup: the previous SQLite file `prisma/dev.db` is kept on disk as a
# reference only. Prisma no longer uses SQLite. Do not point DATABASE_URL at
# `file:./dev.db`.

# --- Auth.js / NextAuth v5 ----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-32-byte-secret"
# Local:
AUTH_URL="http://localhost:3000"
# Production (required for correct email links):
# AUTH_URL="https://studysphere.space"

# --- File storage -------------------------------------------------------------
# Local development (default when Blob is not configured):
UPLOAD_DIR="./uploads"

# Production / Vercel Blob (private store):
# Create a **Private** Blob store in the Vercel dashboard and connect it to the
# project. Vercel injects BLOB_READ_WRITE_TOKEN (and/or BLOB_STORE_ID via OIDC).
# When either Blob env is present, uploads go to private Blob; otherwise the
# app falls back to UPLOAD_DIR on the local filesystem.
# BLOB_READ_WRITE_TOKEN=""
# BLOB_STORE_ID=""

# --- Admin bootstrap ----------------------------------------------------------
# Required by `npm run db:create-admin` (production-safe, non-destructive) and by
# `npx prisma db seed` (local demo data only — it wipes every table first).
# Both scripts refuse to run when these are missing. Never commit real values:
# supply them for a single run, e.g.
#   $env:ADMIN_EMAIL="you@example.com"; $env:ADMIN_PASSWORD="..."; npm run db:create-admin
# Password must satisfy the same policy as registration: 8+ chars, a letter and a digit.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Optional display name (defaults to "StudySphere Admin"):
# ADMIN_NAME=""

# --- Optional search ----------------------------------------------------------
BRAVE_SEARCH_API_KEY=""

# --- Email (Resend) -----------------------------------------------------------
# Required in production so verification and password-reset links are actually
# delivered. Create an API key at https://resend.com and verify the sending
# domain used by EMAIL_FROM.
# Email bodies include absolute links built from AUTH_URL — set AUTH_URL to your
# real production origin (e.g. https://your-app.vercel.app) or users will get
# localhost links.
# When these are unset (local dev), no mail is sent and the register /
# forgot-password responses include the link instead.
RESEND_API_KEY=""
EMAIL_FROM="StudySphere <no-reply@your-domain.com>"

# --- Cloudflare Turnstile (bot protection on auth forms) ----------------------
# Create a widget at https://dash.cloudflare.com/ → Turnstile.
# Hostnames to allow: localhost, studysphere.space, www.studysphere.space
# Managed mode. Siteverify runs server-side with TURNSTILE_SECRET_KEY only.
#
# Local/test dummy keys from Cloudflare (always pass):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
